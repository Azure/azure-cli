#!/usr/bin/env python

import sys
import os

dir = os.path.join(os.path.dirname(os.path.realpath(__file__)), 'src')

if not os.environ.get('PYTHONPATH'):
    os.environ['PYTHONPATH'] = dir
else:
    os.environ['PYTHONPATH'] = os.pathsep.join([
        dir,
        os.environ.get('PYTHONPATH'),
    ])

if os.environ.get('AZ_INSTALLER') is None:
    os.environ['AZ_INSTALLER'] = 'PIP'

# Remove the implicit working-directory import path before loading any modules.
os.execl(
    sys.executable, sys.executable, '-c',
    "import sys; sys.path.pop(0) if sys.path and sys.path[0] == '' else None; "
    "import runpy; runpy.run_module('azure.cli', run_name='__main__', alter_sys=True)",
    *sys.argv[1:]
)
